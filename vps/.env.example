# Surfshark Service Credentials (KHONG phai email/pass login Surfshark!)
# Lay tai: https://my.surfshark.com/vpn/manual-setup/main
#   -> Tab "Manual setup" -> "OpenVPN" -> Show "Credentials"
SURFSHARK_USER=replace_with_surfshark_service_user
SURFSHARK_PASS=replace_with_surfshark_service_pass

# API token (random 32+ chars) - extension dung de auth voi rotate API
VPS_API_TOKEN=replace_with_random_token_32_chars

# HTTP proxy auth - extension dung khi route Chrome qua proxy
PROXY_USER=replace_with_random_proxy_user
PROXY_PASS=replace_with_random_proxy_pass
